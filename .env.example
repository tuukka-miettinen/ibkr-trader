# Copy this file to .env and fill in your local values.

MARKET_DATA_PROVIDER=ibkr

# Default setup: backend connects to the separately managed IBKR gateway stack
# through host-published ports. This keeps app rebuilds from restarting the gateway.
IBKR_HOST=host.docker.internal
IBKR_PORT=4004
IBKR_CLIENT_ID=101
IBKR_EXCHANGE=SMART
IBKR_CURRENCY=USD
IBKR_USE_RTH=false
TICK_FETCH_REQUEST_DELAY_SECONDS=2.0

TWS_USERID=
TWS_PASSWORD=
IBKR_TRADING_MODE=paper
READ_ONLY_API=yes

# Telegram trade notifications (buy/sell events + open-position summary).
# Add your bot to the target group and use the group's chat ID (often a negative number).
TELEGRAM_NOTIFICATIONS_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

TWS_ACCEPT_INCOMING=accept
# Required to enable the gateway's VNC server. Leave blank to disable VNC/noVNC.
VNC_SERVER_PASSWORD=
TWOFA_TIMEOUT_ACTION=restart
AUTO_RESTART_TIME=
RELOGIN_AFTER_TWOFA_TIMEOUT=yes
EXISTING_SESSION_DETECTED_ACTION=primary
TIME_ZONE=Etc/UTC
TWS_SETTINGS_PATH=/home/ibgateway/tws_settings